{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Programmatic final output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "decision", "confidence", "summary", "risks", "next_steps"],
  "properties": {
    "status": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
