      "allow": ["Read", "Grep", "Glob"],
      "ask": ["Bash", "Edit", "Write", "WebFetch", "WebSearch", "Bash(rm:*)", "Bash(rmdir:*)", "Bash(del:*)", "Bash(git push --force:*)"],
      "deny": [
        "Bash(format:*)",
        "Bash(mkfs:*)",
        "Bash(dd:*)",
        "Bash(shred:*)",
        "Read(//**/.env)",
        "Read(//**/.env.*)",
