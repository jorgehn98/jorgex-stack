{
  "name": "jorgex-stack",
  "version": "2.0.3",
  "description": "Configuración compartida de skills, subagentes e integraciones nativas para Claude Code, Codex, OpenCode v2 y Pi oficial",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgehn98/jorgex-stack.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "skills",
    "mcp",
    "engram",
    "harness"
  ],
  "bin": {
    "jorgex-stack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "stack"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:property": "vitest run --dir pilots/property",
    "cli": "node dist/cli.js",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@clack/prompts": "^1.5.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "fast-check": "4.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
