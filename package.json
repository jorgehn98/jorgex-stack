{
  "name": "jorgex-stack",
  "version": "1.3.0",
  "description": "Harness multi-agente portable: instala la config JorgeX (agentes, skills, hooks, Engram, MCPs) en Claude Code, Codex CLI, OpenCode y Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgehn98/jorgex-stack.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "skills",
    "mcp",
    "engram",
    "harness"
  ],
  "bin": {
    "jorgex-stack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "stack",
    "upstreams.json",
    "PRD.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "node dist/cli.js",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
