{
  "name": "jorgex-stack",
  "version": "0.1.0",
  "description": "Harness multi-agente portable: instala la config JorgeX (agentes, skills, hooks, Engram, MCPs) en Claude Code, Codex CLI y OpenCode",
  "type": "module",
